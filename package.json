{
  "name": "dsh-v4flash-tiler",
  "version": "0.2.0",
  "description": "DSH plugin: auto-tiles oversized chat images into labelled grid pieces (row/col metadata, overlap-aware, multi-image group isolation) so the DeepSeek vision model keeps fine detail instead of the ~800px downsample.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doublehappy123/dsh-v4flash-tiler"
  },
  "homepage": "https://github.com/doublehappy123/dsh-v4flash-tiler",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "vision",
    "tiler",
    "image",
    "screenshot"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
